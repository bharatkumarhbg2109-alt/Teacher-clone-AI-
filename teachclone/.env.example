# ═══════════════════════════════════════════════════
# TeachClone — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════

# ── Core security ─────────────────────────────────
# DEV_MODE=true bypasses ALL authentication. Only use on your local machine.
# Never deploy with DEV_MODE=true — the app will refuse to start if ENV != local.
DEV_MODE=true
ENV=local

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production. Auto-generated in DEV_MODE for convenience.
SECRET_KEY=

# ── CORS ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No wildcards in production.
# Example for production: ALLOWED_ORIGINS=https://app.teachclone.com
ALLOWED_ORIGINS=http://localhost:3000

# ── App URLs ──────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── Database ──────────────────────────────────────
# Free local mode: SQLite (no install needed)
DATABASE_URL=sqlite+aiosqlite:///./teachclone.db
# Production PostgreSQL (uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/teachclone
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Task queue ────────────────────────────────────
# INLINE_TASKS=true runs background jobs in-process. No Redis or Celery needed.
# Set to false in production and configure CELERY_BROKER_URL below.
INLINE_TASKS=true
REDIS_URL=redis://localhost:6379/0

# ── Vector store ──────────────────────────────────
# local = file-based vector store in storage_data/. No Qdrant install needed.
VECTOR_BACKEND=local
# For production Qdrant: VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=teachclone_chunks

# ── Object storage ────────────────────────────────
# local = files saved to LOCAL_STORAGE_DIR on disk
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data/
# For S3/R2/MinIO (uncomment and fill):
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=teachclone-media
# S3_REGION=auto

# ── System Prerequisites (FFmpeg) ────────────────
# FFmpeg is required for local audio extraction from media/videos:
# - Windows: winget install Gyan.FFmpeg   (or download from https://gyan.dev/ffmpeg/builds)
# - macOS:   brew install ffmpeg
# - Linux:   sudo apt update && sudo apt install -y ffmpeg

# ── LLM Provider (Free Local First) ──────────────
# Free & offline default: LLM_PROVIDER=ollama (connects to local Ollama server).
# Install from https://ollama.com then run: ollama pull llama3.1:8b
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=mistral
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=2000
OLLAMA_NUM_CTX=8192

# Optional paid providers (used ONLY when provider configured and key set):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Teacher DNA pipeline ──────────────────────────
USE_DNA_PIPELINE=true
DNA_WHISPER_MODEL=medium
DNA_TRANSCRIPT_CHAR_LIMIT=12000
DNA_EMBED_TRANSCRIPTS=true
DNA_REPORTS_DIR=./dna_reports
SYSTEM_PROMPTS_DIR=./system_prompts

# ── Embeddings ────────────────────────────────────
# Free: hash embeddings (no model download needed)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=512
# Free: local BGE model (downloaded automatically on first run)
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIM=1024
# LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Optional paid OpenAI embeddings:
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072

# ── Speech to text ────────────────────────────────
# Free: faster-whisper runs locally (CPU or GPU)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Text to speech ────────────────────────────────
# Free: Piper TTS runs locally
TTS_PROVIDER=piper
PIPER_VOICE=en_US-amy-medium
# Optional paid:
# TTS_PROVIDER=openai
# OPENAI_TTS_MODEL=tts-1
# DEFAULT_TTS_VOICE=nova
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=

# ── Auth — Clerk ──────────────────────────────────
# Leave blank when DEV_MODE=true. Required for production.
# Get keys from https://clerk.com dashboard
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# ── Billing — Stripe ──────────────────────────────
# Leave blank for full mock mode (logs to billing_log.json, no real charges).
# Use sk_test_ keys for testing — never sk_live_ in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=
STRIPE_INSTITUTION_PRICE_ID=

# ── Email ─────────────────────────────────────────
# log = writes email content to email_log.txt (free, no sending)
EMAIL_BACKEND=log
FROM_EMAIL=noreply@teachclone.app
# For production sending via Resend (https://resend.com):
# RESEND_API_KEY=re_...

# ── Monitoring ────────────────────────────────────
SENTRY_DSN=

# ── Rate limiting ─────────────────────────────────
RATE_LIMIT_CHAT=30
RATE_LIMIT_DNA=5
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_VOICE=60
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BACKOFF_BASE=60
RATE_LIMIT_BACKOFF_MAX=900

# ── Free-plan quotas ─────────────────────────────
FREE_VIDEOS_PER_MONTH=3
FREE_MESSAGES_PER_DAY=50
FREE_QUIZZES_PER_MONTH=5
FREE_EXPORTS_PER_MONTH=2

# ── Upload limits ─────────────────────────────────
MULTIPART_THRESHOLD_BYTES=67108864
MULTIPART_PART_SIZE_BYTES=33554432

# ── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
