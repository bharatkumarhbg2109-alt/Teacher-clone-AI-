FROM python:3.11-slim

# Heavier image than the API: media + document processing toolchain.
#   ffmpeg      — audio/video extraction
#   yt-dlp      — YouTube / link downloads (installed via pip below)
#   tesseract   — OCR for scanned pages / images
#   poppler     — PDF -> image rendering fallback
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        ffmpeg \
        tesseract-ocr \
        poppler-utils \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download the whisper model at build time so first ingest is fast.
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('base', device='cpu', compute_type='int8')"

COPY apps/api/ .

ENV WHISPER_MODEL=base \
    WHISPER_DEVICE=cpu \
    WHISPER_COMPUTE_TYPE=int8 \
    TORCH_NUM_THREADS=2

CMD ["celery", "-A", "app.worker", "worker", "--loglevel=info", "-Q", "media,ai", "-c", "2"]
