# Dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage/

# Build artifacts
dist/
dist-electron/
.next/
out/
.turbo/
*.tsbuildinfo

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
secrets/

# Large media & uploads (directories tracked via .gitkeep)
backend/uploads/pdfs/*
!backend/uploads/pdfs/.gitkeep
backend/uploads/sources/*
!backend/uploads/sources/.gitkeep
apps/api/uploads/*
!apps/api/uploads/.gitkeep
apps/api/tmp/*
!apps/api/tmp/.gitkeep

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Databases, vector stores & serialized artifacts
*.db
*.sqlite3
chroma/
*.bin
*.pkl
*.pickle
*.graphml

# DNA artifacts & uploads (directories preserved via .gitkeep)
**/dna_reports/*.json
!**/dna_reports/.gitkeep
**/system_prompts/*
!**/system_prompts/.gitkeep
!**/system_prompts/
uploads/
!uploads/**/.gitkeep
!**/uploads/.gitkeep
!**/tmp/.gitkeep

# Local audit & logs
.freebuff/
.audit-files.txt
*.log
review_log.txt
